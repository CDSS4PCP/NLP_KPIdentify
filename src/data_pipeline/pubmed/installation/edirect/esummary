pth=$( dirname "$0" )

case ":$PATH:" in
  *:"$pth":* )
    ;;
  * )
    PATH="$PATH:$pth"
    export PATH
    ;;
esac

# read command-line arguments to intercept -format or -docsum

hasFormat=false
for arg in "$@"
do
  case "$arg" in
    -format )
      hasFormat=true
      ;;
    -docsum )
      echo "ERROR: Esummary -docsum argument is superfluous, remove or use efetch, redirecting for now" >&2
      efetch "$@"
      exit 0
      # exit 1
      ;;
    docsum )
      if [ "$hasFormat" = true ]
      then
        echo "ERROR: Esummary -format docsum is superfluous, remove or use efetch, redirecting for now" >&2
        efetch "$@"
        exit 0
        # exit 1
      fi
      ;;
    * )
      if [ "$hasFormat" = true ]
      then
        echo "ERROR: Esummary with incompatible -format $arg, remove or use efetch, redirecting for now" >&2
        efetch "$@"
        exit 0
        # exit 1
      fi
      ;;
  esac
done

if [ "$hasFormat" = true ]
then
  echo "ERROR: Esummary with dangling -format, remove or use efetch with desired -format, redirecting for now" >&2
  efetch "$@" docsum
  exit 0
  # exit 1
fi

# conditionally execute original Perl implementation

PERL=""

internal=false
while [ "$#" -ne 0 ]
do
  case "$1" in
    -internal )
      internal=true
      shift
      ;;
    -newmode )
      USE_NEW_EDIRECT=1
      shift
      ;;
    -oldmode )
      USE_NEW_EDIRECT=0
      shift
      ;;
    * )
      break
      ;;
  esac
done
if [ "$internal" = true ]
then
  set _ -internal "$@"
  shift
fi

if [ ! -f "$pth"/ecommon.sh ]
then
  USE_NEW_EDIRECT=false
fi

case "${USE_NEW_EDIRECT}" in
  [FfNn]* | 0 | [Oo][Ff][Ff] )
    # set PERL path if using old EDirect
    PERL=perl
    case "$( uname -s )" in
      CYGWIN_NT* )
        # Use a negative match here because the shell treats 0 as success.
        if perl -e 'exit $^O !~ /^MSWin/'; then
           pth=$( cygpath -w "$pth" )
        fi
        ;;
      Darwin )
        PERL="/usr/bin/perl"
        ;;
    esac
    ;;
  "" | * )
    ;;
esac

if [ -n "${PERL}" ]
then
  exec "${PERL}" "$pth"/edirect.pl -fetch -format docsum "$@"
  exit 0
fi

# otherwise call efetch -docsum

efetch -docsum "$@"

